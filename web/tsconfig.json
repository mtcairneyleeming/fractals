{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "lib": ["DOM", "DOM.Iterable", "ES2022"],
        "moduleResolution": "bundler",
        "types": ["vite/client"],
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowJs": false
    },
    "include": ["./web/**/*.ts", "./lsystems/*.ts", "./3d/**/*.ts", "./vite.config.ts"],
    "exclude": ["./web/old/**"]
}
